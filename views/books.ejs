<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h3>Books are having </h3>
    <a href="http://localhost:3000/new"> Add new Book</a>
    <% for(book of books) {%>
        <div style="border: 1px solid black; padding: 5px;margin: 8px;background-color: aqua;border-radius: 6px;width: 450px;">
        <p>title:<%= book.title %></p>
        <p>author:<%= book.author %></p>
        <p>price:<%= book.price %></p>
        <p>pages:<%= book.pages%></p>
    </div>
    <%}%>
</body>
</html>